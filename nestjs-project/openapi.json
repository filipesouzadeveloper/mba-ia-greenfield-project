    "/videos/{id}/upload/complete": {
      "post": {
        "description": "Completes the multipart upload with the parts already stored, checks the final object and queues the video for processing, moving it from draft to processing. Only the owner of a draft video can call it.",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
