            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Upload completed and video queued for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedUploadDto"
