    "/videos/{slug}/stream": {
      "get": {
        "description": "Streams the original file of a ready video from the private storage without buffering it. A single-range `Range` header returns 206 with that byte range, which lets players seek without downloading the whole file; without it the whole file is returned.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "Video slug",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "description": "Single byte range: `bytes=start-end`, `bytes=start-` or `bytes=-suffix`. Multiple ranges are ignored and the whole file is returned.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Whole file",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/webm": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Requested byte range, described by `Content-Range`",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "video/webm": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "video/mp4": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/webm": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "416": {
            "description": "Range starts beyond the file, is reversed or is malformed; `Content-Range: bytes */{size}` carries the file size",
            "content": {
              "video/mp4": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              },
              "video/webm": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{slug}/download": {
      "get": {
        "description": "Same as streaming, plus `Content-Disposition: attachment` with the original filename. `Range` is honored, so an interrupted download can be resumed.",
        "operationId": "VideosController_download",
